{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacklok.com/matlatl/schemas/graph.schema.json",
  "title": "matlatl graph.json",
  "description": "The primary machine-/LLM-queryable manifest of an analyzed markdown corpus emitted by `matlatl graph --format json`. This schema is the published contract; the emitter type internal/infrastructure/emit/graphjson.Document is kept in lockstep and a test validates emitted bytes against this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "generatedNote",
    "summary",
    "nodes",
    "edges",
    "sections",
    "orphans",
    "unreachable",
    "underLinked",
    "deadEnd",
    "bowtie",
    "brokenLinks",
    "brokenAnchors",
    "ambiguous",
    "components",
    "hits",
    "betweenness",
    "gaps",
    "suggestedLinks",
    "articulationPoints",
    "bridges",
    "rootSet",
    "reachability"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 5 },
    "tool": { "type": "string" },
    "generatedNote": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documents", "sections", "edges", "references", "components",
        "orphans", "unreachable", "underLinked", "deadEnd",
        "brokenLinks", "brokenAnchors", "ambiguous", "knowledgeGaps", "suggestedLinks",
        "articulationPoints", "bridges",
        "navigability"
      ],
      "properties": {
        "documents": { "type": "integer", "minimum": 0 },
        "sections": { "type": "integer", "minimum": 0 },
        "edges": { "type": "integer", "minimum": 0 },
        "references": { "type": "integer", "minimum": 0 },
        "components": { "type": "integer", "minimum": 0 },
        "orphans": { "type": "integer", "minimum": 0 },
        "unreachable": { "type": "integer", "minimum": 0 },
        "underLinked": { "type": "integer", "minimum": 0 },
        "deadEnd": { "type": "integer", "minimum": 0 },
        "brokenLinks": { "type": "integer", "minimum": 0 },
        "brokenAnchors": { "type": "integer", "minimum": 0 },
        "ambiguous": { "type": "integer", "minimum": 0 },
        "knowledgeGaps": { "type": "integer", "minimum": 0 },
        "suggestedLinks": { "type": "integer", "minimum": 0 },
        "articulationPoints": { "type": "integer", "minimum": 0 },
        "bridges": { "type": "integer", "minimum": 0 },
        "navigability": {
          "description": "Corpus-level navigability / structural-health scalars (ADR 0014). Compactness and stratum are computed over the directed projection; characteristic/median path length, diameter and clustering over the undirected closure. Pure data; never a finding and never gates the check exit code.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compactness", "stratum", "characteristicPathLength",
            "medianPathLength", "clusteringCoefficient", "diameter", "reachablePairs"
          ],
          "properties": {
            "compactness": { "type": "number", "minimum": 0, "maximum": 1 },
            "stratum": { "type": "number", "minimum": 0, "maximum": 1 },
            "characteristicPathLength": { "type": "number", "minimum": 0 },
            "medianPathLength": { "type": "number", "minimum": 0 },
            "clusteringCoefficient": { "type": "number", "minimum": 0, "maximum": 1 },
            "diameter": { "type": "integer", "minimum": 0 },
            "reachablePairs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "kind", "title", "path", "description", "category",
          "inDegree", "outDegree", "component", "hubScore", "authorityScore",
          "reachable", "orphan", "intentionalOrphan", "underLinked", "deadEnd", "bowtie",
          "betweenness", "isArticulation"
        ],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["doc", "section"] },
          "title": { "type": "string" },
          "path": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "inDegree": { "type": "integer", "minimum": 0 },
          "outDegree": { "type": "integer", "minimum": 0 },
          "component": { "type": "string" },
          "hubScore": { "type": "number", "minimum": 0 },
          "authorityScore": { "type": "number", "minimum": 0 },
          "reachable": { "type": "boolean" },
          "orphan": { "type": "boolean" },
          "intentionalOrphan": { "type": "boolean" },
          "underLinked": { "type": "boolean" },
          "deadEnd": { "type": "boolean" },
          "bowtie": {
            "type": "string",
            "enum": ["core", "in", "out", "tendril", "disconnected"]
          },
          "betweenness": { "type": "number", "minimum": 0, "maximum": 1 },
          "isArticulation": { "type": "boolean" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "type", "health"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string" },
          "health": { "type": "string" }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "doc", "slug", "level", "title"],
        "properties": {
          "id": { "type": "string" },
          "doc": { "type": "string" },
          "slug": { "type": "string" },
          "level": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" }
        }
      }
    },
    "orphans": { "type": "array", "items": { "type": "string" } },
    "unreachable": { "type": "array", "items": { "type": "string" } },
    "underLinked": { "type": "array", "items": { "type": "string" } },
    "deadEnd": { "type": "array", "items": { "type": "string" } },
    "bowtie": {
      "description": "Corpus-level bow-tie classification relative to the giant strongly-connected component (the 'core'): per-bucket document counts plus the giant SCC id and size. A giantSccSize of 1 means there is no cyclic core (every SCC is a singleton).",
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "in", "out", "tendril", "disconnected", "giantScc", "giantSccSize"],
      "properties": {
        "core": { "type": "integer", "minimum": 0 },
        "in": { "type": "integer", "minimum": 0 },
        "out": { "type": "integer", "minimum": 0 },
        "tendril": { "type": "integer", "minimum": 0 },
        "disconnected": { "type": "integer", "minimum": 0 },
        "giantScc": { "type": "string" },
        "giantSccSize": { "type": "integer", "minimum": 0 }
      }
    },
    "brokenLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "target", "detail"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "target": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "brokenAnchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "target", "expectedSlug", "detail"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "target": { "type": "string" },
          "expectedSlug": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "ambiguous": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "target", "candidates", "detail"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "target": { "type": "string" },
          "candidates": { "type": "array", "items": { "type": "string" } },
          "detail": { "type": "string" }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wcc", "scc"],
      "properties": {
        "wcc": { "$ref": "#/$defs/componentList" },
        "scc": { "$ref": "#/$defs/componentList" }
      }
    },
    "hits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topHubs", "topAuthorities"],
      "properties": {
        "topHubs": { "$ref": "#/$defs/rankedList" },
        "topAuthorities": { "$ref": "#/$defs/rankedList" }
      }
    },
    "betweenness": {
      "description": "Critical-path centrality (ADR 0015): the top documents by directed betweenness — those on the most shortest paths between other documents (the corpus' load-bearing connectors). Parallel to `hits`. Pure data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["topDocs"],
      "properties": {
        "topDocs": { "$ref": "#/$defs/rankedList" }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentA", "componentB", "representativeA", "representativeB"],
        "properties": {
          "componentA": { "type": "string" },
          "componentB": { "type": "string" },
          "representativeA": { "type": "string" },
          "representativeB": { "type": "string" }
        }
      }
    },
    "suggestedLinks": {
      "description": "Topology-based link-prediction suggestions (ADR 0013): pairs of documents that share navigational neighbours but do not link to each other, ranked by Adamic/Adar. An additive signal alongside `gaps`; capped, with truncation surfaced as a notice.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["docA", "docB", "sharedNeighbours", "coupling", "coCitation", "adamicAdar"],
        "properties": {
          "docA": { "type": "string" },
          "docB": { "type": "string" },
          "sharedNeighbours": { "type": "integer", "minimum": 0 },
          "coupling": { "type": "integer", "minimum": 0 },
          "coCitation": { "type": "integer", "minimum": 0 },
          "adamicAdar": { "type": "number", "minimum": 0 }
        }
      }
    },
    "articulationPoints": {
      "description": "Cut vertices of the undirected link closure (ADR 0015): documents whose removal fragments the corpus into more pieces. Sorted DocumentIDs. Pure data; surfaced as non-gating Info findings too.",
      "type": "array",
      "items": { "type": "string" }
    },
    "bridges": {
      "description": "Cut edges of the undirected link closure (ADR 0015): links that are the only connection between two parts of the corpus. `from` < `to` canonically; sorted. Pure data; surfaced as non-gating Info findings too.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    },
    "rootSet": { "type": "array", "items": { "type": "string" } },
    "reachability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indeterminate"],
      "properties": { "indeterminate": { "type": "boolean" } }
    }
  },
  "$defs": {
    "componentList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "members"],
        "properties": {
          "id": { "type": "string" },
          "members": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "rankedList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score"],
        "properties": {
          "id": { "type": "string" },
          "score": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
